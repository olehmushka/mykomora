# Copy to deploy/.env.prod ON THE VPS and fill in. `deploy/.env.prod` is
# git-ignored; never commit real values.

# --- public address ---------------------------------------------------------
# The hostname the browser uses, no scheme and no trailing slash. A free
# DuckDNS name works: yourname.duckdns.org pointing at the VPS's IPv4 address.
DOMAIN=yourname.duckdns.org
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com

# --- postgres ---------------------------------------------------------------
POSTGRES_USER=mykomora
# Hex only, so it is safe inside DATABASE_URL:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=mykomora

# --- core-api ---------------------------------------------------------------
LOG_LEVEL=info
# At least 32 characters:  openssl rand -base64 48
APP_SECRET=

# Google OAuth client. Authorised redirect URI must be exactly:
#   https://<DOMAIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# --- object storage: Cloudflare R2 -------------------------------------------
# https://<account-id>.r2.cloudflarestorage.com  (R2 > Overview > S3 API)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mykomora-media
# R2 > Manage API tokens > Object Read & Write, scoped to the two buckets.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- backups (deploy/backup.sh) -----------------------------------------------
# A second, private bucket. Reuses the S3_* credentials and endpoint above.
BACKUP_BUCKET=mykomora-backups
