# Copy to deploy/.env and adjust. `deploy/.env` is git-ignored.
#
# These are LOCAL DEVELOPMENT defaults. Production values are injected on the
# VPS and must never be committed.

# --- shared ----------------------------------------------------------------
ENV=development
LOG_LEVEL=debug

# Port Caddy publishes on the host. Everything reaches the stack through here.
PUBLIC_PORT=8080

# --- postgres --------------------------------------------------------------
POSTGRES_USER=mykomora
POSTGRES_PASSWORD=mykomora
POSTGRES_DB=mykomora
# Exposed on the host so psql, `make migrate-*` and sqlc vet can reach it.
POSTGRES_PORT=5432

# --- core-api --------------------------------------------------------------
CORE_API_PORT=8081
# Host `postgres` is the Compose service name, resolved inside the network.
DATABASE_URL=postgres://mykomora:mykomora@postgres:5432/mykomora?sslmode=disable

# --- web -------------------------------------------------------------------
WEB_PORT=3000
# Server-side only: the browser talks to core-api through Caddy, same origin.
CORE_API_URL=http://core-api:8081

# --- object storage (used from M4) -----------------------------------------
# LocalStack stands in for the production bucket (R2/B2). SPEC.md originally
# named MinIO; its images were withdrawn from Docker Hub, so the stack would no
# longer start from a fresh clone.
#
# These credentials are local-only dummies. Production keys are injected on the
# VPS and never committed.
S3_PORT=4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=mykomora-dev
S3_ENDPOINT=http://s3:4566
