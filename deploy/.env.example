# Copy to deploy/.env and adjust. `deploy/.env` is git-ignored.
#
# These are LOCAL DEVELOPMENT defaults. Production values are injected on the
# VPS and must never be committed.

# --- shared ----------------------------------------------------------------
ENV=development
LOG_LEVEL=debug

# Port Caddy publishes on the host. Everything reaches the stack through here.
PUBLIC_PORT=8080

# --- postgres --------------------------------------------------------------
POSTGRES_USER=mykomora
POSTGRES_PASSWORD=mykomora
POSTGRES_DB=mykomora
# Exposed on the host so psql, `make migrate-*` and sqlc vet can reach it.
POSTGRES_PORT=5432

# --- core-api --------------------------------------------------------------
CORE_API_PORT=8081
# Host `postgres` is the Compose service name, resolved inside the network.
DATABASE_URL=postgres://mykomora:mykomora@postgres:5432/mykomora?sslmode=disable

# The origin the browser sees. Invite links and the post-sign-in redirect are
# built from it, so it is Caddy's address and not core-api's.
PUBLIC_BASE_URL=http://localhost:8080

# Signs the access tokens and the OAuth flow cookie. core-api refuses to start
# without at least 32 characters. This one is a LOCAL DEVELOPMENT value and is
# published in this file — generate a real one for the VPS:
#
#   openssl rand -base64 48
APP_SECRET=local-development-secret-not-for-production

# --- google sign-in --------------------------------------------------------
# Leave these empty and the stack still runs: every page works, and only
# sign-in reports itself unavailable. To turn it on, create an OAuth client in
# the Google Cloud Console and paste the credentials here — see "Google
# sign-in" in the README for the five-minute version.
#
# The redirect URI must match the one registered with Google exactly, and must
# point at Caddy: core-api's own port is a different origin, and the session
# cookies would not apply to the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# How long a session lives. The access token is short because revocation
# happens at the refresh, not at the access, token.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Seven days, per SPEC.
INVITE_TTL=168h

# --- web -------------------------------------------------------------------
WEB_PORT=3000
# Server-side only: the browser talks to core-api through Caddy, same origin.
CORE_API_URL=http://core-api:8081

# --- object storage (used from M4) -----------------------------------------
# LocalStack stands in for the production bucket (R2/B2). SPEC.md originally
# named MinIO; its images were withdrawn from Docker Hub, so the stack would no
# longer start from a fresh clone.
#
# These credentials are local-only dummies. Production keys are injected on the
# VPS and never committed.
S3_PORT=4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=mykomora-dev
S3_ENDPOINT=http://s3:4566
