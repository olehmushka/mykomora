# Copy to terraform.tfvars (git-ignored). Secrets (tokens, state passphrase)
# are NOT put here: export them as TF_VAR_hcloud_token,
# TF_VAR_cloudflare_api_token and TF_VAR_state_passphrase.
cloudflare_account_id = ""
domain                = "yourname.duckdns.org"
admin_ssh_public_key  = "ssh-ed25519 AAAA... you@laptop"
deploy_ssh_public_key = "ssh-ed25519 AAAA... github-actions-deploy"
