# Copy to terraform.tfvars (git-ignored). Secrets (the Hetzner token and the
# state passphrase) are NOT put here: export them as TF_VAR_hcloud_token and
# TF_VAR_state_passphrase.
admin_ssh_public_key  = "ssh-ed25519 AAAA... you@laptop"
deploy_ssh_public_key = "ssh-ed25519 AAAA... github-actions-deploy"
